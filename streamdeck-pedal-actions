    def start_monitor(self):
        try:
            self.monitor=DeviceMonitor()
            asyncio.get_running_loop().add_reader(self.monitor.fd,self.device_changed)
        except (OSError,AttributeError):
            if self.monitor:self.monitor.close()
            self.monitor=None  # Restricted/container environments retain bounded discovery.
    def device_changed(self):
        try:
            # Limit each callback so an event burst cannot starve input/RPC.
            for _ in range(32):
