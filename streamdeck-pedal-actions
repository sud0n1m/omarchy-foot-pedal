def defaults(): return {"version": 1, "enabled": True, "active": "workspaces", "presets": []}
def atomic_write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".pedal-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(value, f, indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
        os.replace(tmp, path)
        d = os.open(path.parent, os.O_DIRECTORY)
        try: os.fsync(d)
        finally: os.close(d)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def validate_action(a, available=False):
    if not isinstance(a, dict) or a.get("type") not in ACTIONS: raise ValueError("Choose a valid action")
    kind = a["type"]; out = {"type": kind}
    dep = ACTIONS[kind][1]
    if available and dep and not shutil.which(dep): raise ValueError(f"{ACTIONS[kind][0]} needs {dep}")
    if kind.startswith("mic_"):
        source = a.get("source", "")
        if not isinstance(source, str) or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,250}", source) or source.endswith(".monitor"):
            raise ValueError("Choose a microphone for this action")
        out["source"] = source
    if kind == "shortcut":
        key, mods = a.get("key", ""), a.get("modifiers", [])
        if not isinstance(key, str) or not re.fullmatch(r"(?:[a-z0-9]|F(?:[1-9]|[12][0-9]|3[0-5])|Return|Tab|Escape|space|BackSpace|Delete|Insert|Home|End|Page_Up|Page_Down|Left|Right|Up|Down|minus|equal|comma|period|slash|semicolon|apostrophe|bracketleft|bracketright|backslash|grave)", key):
            raise ValueError("Record a supported keyboard shortcut")
        if not isinstance(mods, list) or len(mods)>4 or any(m not in ["ctrl", "shift", "alt", "logo"] for m in mods): raise ValueError("Invalid shortcut modifiers")
        out.update(key=key, modifiers=list(dict.fromkeys(mods)))
    if kind == "command":
        exe, args, cwd = a.get("executable", ""), a.get("arguments", ""), a.get("cwd", "")
        if not isinstance(exe, str) or not exe.strip() or len(exe)>4096: raise ValueError("Enter an executable")
        if not isinstance(args, str) or len(args)>8192: raise ValueError("Arguments are too long")
        shlex.split(args)
        if not isinstance(cwd, str) or len(cwd)>4096: raise ValueError("Invalid working directory")
        exe = os.path.expanduser(exe.strip())
        cwd = os.path.expanduser(cwd.strip())
        if available and not shutil.which(exe): raise ValueError("Executable not found or not executable")
        if available and cwd and not Path(cwd).is_dir(): raise ValueError("Working directory does not exist")
        out.update(executable=exe, arguments=args, cwd=cwd)
    return out

def validate_preset(p, available=False):
    name = p.get("name", "").strip() if isinstance(p.get("name"), str) else ""
    if not name or len(name)>60: raise ValueError("Give the preset a name (up to 60 characters)")
    acts = p.get("actions")
    if not isinstance(acts, list) or len(acts)!=3: raise ValueError("A preset must have three pedals")
    return {"id": p.get("id", ""), "name": name, "builtin": False,
            "actions": [validate_action(a, available) for a in acts]}

def find_pedal():
    for entry in Path("/sys/class/hidraw").glob("hidraw*"):
        for parent in (entry.resolve(), *entry.resolve().parents):
            vendor, product = parent / "idVendor", parent / "idProduct"
            if vendor.exists() and product.exists():
                if vendor.read_text().strip()==VENDOR_ID and product.read_text().strip()==PRODUCT_ID: return Path("/dev") / entry.name
                break
    return None

async def run(*args, timeout=5, cwd=None):
    proc = await asyncio.create_subprocess_exec(*args, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE, cwd=cwd, start_new_session=True)
    async def collect(stream):
        chunks=[]; size=0
        while chunk:=await stream.read(8192):
            if size<65536:
                chunks.append(chunk[:65536-size]);size+=len(chunks[-1])
        return b"".join(chunks)
    try:
        stdout, stderr, _ = await asyncio.wait_for(asyncio.gather(collect(proc.stdout), collect(proc.stderr), proc.wait()), timeout)
    except (asyncio.TimeoutError, asyncio.CancelledError) as e:
        try: os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        await proc.wait()
        if isinstance(e, asyncio.TimeoutError): raise RuntimeError(f"Action timed out after {timeout:g} seconds") from e
        raise
    if proc.returncode: raise RuntimeError(stderr.decode(errors="replace").strip()[:250] or f"{args[0]} exited {proc.returncode}")
    return stdout.decode(errors="replace").strip()

class DeviceMonitor:
    """Use libudev's filtered, post-permission HID notifications without a helper."""
    def __init__(self):
        self.context=None;self.monitor=None
        self.lib=ctypes.CDLL("libudev.so.1",use_errno=True)
        ptr=ctypes.c_void_p
        signatures={
            "udev_new":([],ptr), "udev_unref":([ptr],ptr),
            "udev_monitor_new_from_netlink":([ptr,ctypes.c_char_p],ptr),
            "udev_monitor_unref":([ptr],ptr),
            "udev_monitor_filter_add_match_subsystem_devtype":([ptr,ctypes.c_char_p,ctypes.c_char_p],ctypes.c_int),
            "udev_monitor_enable_receiving":([ptr],ctypes.c_int),
            "udev_monitor_get_fd":([ptr],ctypes.c_int),
            "udev_monitor_receive_device":([ptr],ptr), "udev_device_unref":([ptr],ptr),
        }
        for name,(args,result) in signatures.items():
            fn=getattr(self.lib,name);fn.argtypes=args;fn.restype=result
        try:
            self.context=self.lib.udev_new()
            if not self.context:raise OSError("Could not create udev context")
            self.monitor=self.lib.udev_monitor_new_from_netlink(self.context,b"udev")
            if not self.monitor:raise OSError("Could not create udev monitor")
            if self.lib.udev_monitor_filter_add_match_subsystem_devtype(self.monitor,b"hidraw",None)<0:raise OSError("Could not filter udev events")
            if self.lib.udev_monitor_enable_receiving(self.monitor)<0:raise OSError("Could not subscribe to udev events")
            self.fd=self.lib.udev_monitor_get_fd(self.monitor)
            if self.fd<0:raise OSError("Could not get udev socket")
        except BaseException:
            self.close();raise
    def receive(self):
        ctypes.set_errno(0)
        device=self.lib.udev_monitor_receive_device(self.monitor)
        if device:self.lib.udev_device_unref(device);return True
        code=ctypes.get_errno()
        if code not in (0,errno.EAGAIN,errno.EWOULDBLOCK):raise OSError(code,os.strerror(code))
        return False
    def close(self):
        if self.monitor:self.lib.udev_monitor_unref(self.monitor);self.monitor=None
        if self.context:self.lib.udev_unref(self.context);self.context=None

class Daemon:
    def __init__(self, config=CONFIG, runtime=RUNTIME):
        self.config_path, self.runtime = Path(config), Path(runtime)
        self.config = defaults(); self.config_error = ""
        try:
            if self.config_path.exists():
                cfg = json.loads(self.config_path.read_text())
                if cfg.get("version") != 1 or type(cfg.get("enabled")) is not bool or not isinstance(cfg.get("presets"), list): raise ValueError("Unsupported configuration")
                ps = [validate_preset(p) for p in cfg["presets"]]
                ids = [p["id"] for p in ps]
                if len(ids)!=len(set(ids)) or any(not isinstance(i,str) or not i.startswith("custom-") for i in ids): raise ValueError("Invalid preset IDs")
                if cfg.get("active") not in ["workspaces", "media"]+ids: raise ValueError("Invalid active preset")
                self.config = {"version":1, "enabled":cfg["enabled"], "active":cfg["active"], "presets":ps}
        except (OSError, ValueError, TypeError) as e:
            self.config_error = f"Configuration needs attention: {e}. Original setup loaded, actions paused."
            self.config["enabled"] = False
        self.connected=False; self.device_error=""; self.fd=None; self.pressed=[False]*3
        self.armed=[False]*3; self.last_input=None; self.errors=[""]*3; self.busy=set()
        self.epoch=0; self.clients=set(); self.test_owner=None; self.test_until=0; self.test_rearm=False
        self.holds={}; self.mic_lock=asyncio.Lock(); self.tasks=set(); self.sources=[]; self.startup=False
        self.baseline=False; self.closing=False; self.mutation_lock=asyncio.Lock()
