            asyncio.get_running_loop().remove_reader(self.fd); os.close(self.fd); self.fd=None
        self.baseline=False; self.connected=False; self.device_error=reason; self.pressed=[False]*3; self.armed=[False]*3; self.epoch+=1;self.rescan=True
        self.spawn(self.release_all()); self.publish()
    async def execute(self,i,a,epoch):
        if epoch!=self.epoch or not self.allowed(): return
        if i in self.busy:
            self.errors[i]="Previous action is still running"; self.publish(); return
        self.busy.add(i); self.errors[i]=""; self.publish()
        try:
            kind=a["type"]
            if kind=="none": return
            validate_action(a,True)
            if kind.startswith("workspace_"):
                step="e-1" if kind=="workspace_previous" else "e+1"
                await run("hyprctl","eval",f'hl.dispatch(hl.dsp.focus({{ workspace = "{step}" }}))')
            elif kind=="dictation": await run("voxtype","record","toggle")
            elif kind.startswith("media_"):
                players=[line.split()[0] for line in (await run("busctl","--user","--no-pager","--no-legend","list")).splitlines() if line.startswith("org.mpris.MediaPlayer2.")]
                if not players: raise ValueError("No media player is available")
                # Prefer the currently playing player; deterministic fallback otherwise.
                target=sorted(players)[0]
                for p in sorted(players):
                    try:
                        if '"Playing"' in await run("busctl","--user","get-property",p,"/org/mpris/MediaPlayer2","org.mpris.MediaPlayer2.Player","PlaybackStatus"):
                            target=p; break
                    except RuntimeError: continue
                method={"media_previous":"Previous","media_next":"Next","media_toggle":"PlayPause"}[kind]
                await run("busctl","--user","call",target,"/org/mpris/MediaPlayer2","org.mpris.MediaPlayer2.Player",method)
            elif kind=="shortcut":
                args=["wtype"]
                for m in a["modifiers"]: args += ["-M",m]
                args += ["-k",a["key"]]
                for m in reversed(a["modifiers"]): args += ["-m",m]
                await run(*args)
            elif kind=="command": await run(a["executable"],*shlex.split(a["arguments"]),cwd=a["cwd"] or str(Path.home()),timeout=10)
            elif kind=="mic_toggle":
                async with self.mic_lock:
                    if a["source"] in self.holds: raise ValueError("Microphone is held by push-to-talk")
                    await run("pactl","set-source-mute",a["source"],"toggle")
            elif kind=="mic_hold":
                async with self.mic_lock:
                    if epoch!=self.epoch or not self.pressed[i] or not self.allowed(): return
                    source=a["source"]
                    if source not in self.holds:
                        muted="yes" in (await run("pactl","get-source-mute",source)).lower()
                        # Recheck after awaited read; release/mode changes may have arrived.
                        if epoch!=self.epoch or not self.pressed[i] or not self.allowed(): return
                        self.holds[source]={"muted":muted,"owners":set()}
                        self.write_recovery()
                        try: await run("pactl","set-source-mute",source,"0")
                        except Exception:
                            await self.restore_source(source); raise
                    self.holds[source]["owners"].add(i)
                    if epoch!=self.epoch or not self.pressed[i] or not self.allowed():
                        self.holds[source]["owners"].discard(i)
                        if not self.holds[source]["owners"]: await self.restore_source(source)
        except Exception as e:
            self.errors[i]=str(e) or type(e).__name__; self.publish()
        finally: self.busy.discard(i); self.publish()
    def write_recovery(self):
        atomic_write(self.runtime / "microphone-recovery.json",{s:v["muted"] for s,v in self.holds.items()})
    async def restore_source(self,source):
        await run("pactl","set-source-mute",source,"1" if self.holds[source]["muted"] else "0")
        del self.holds[source]; self.write_recovery()
        for i,e in enumerate(self.errors):
            if e.startswith("Microphone restor"): self.errors[i]=""
    async def release(self,i):
        async with self.mic_lock:
            for source in list(self.holds):
                self.holds[source]["owners"].discard(i)
                if not self.holds[source]["owners"]:
                    try: await self.restore_source(source)
                    except Exception as e: self.errors[i]=f"Microphone restore failed: {e}"
        self.publish()
    async def release_all(self):
        async with self.mic_lock:
            for source in list(self.holds):
                self.holds[source]["owners"].clear()
                try: await self.restore_source(source)
                except Exception as e: self.errors[1]=f"Microphone restore failed: {e}"
        self.publish()
    async def recover(self):
        path=self.runtime / "microphone-recovery.json"
        try: pending=json.loads(path.read_text())
        except (FileNotFoundError,ValueError): return
        remaining={}
        for source, muted in pending.items():
            try: await run("pactl","set-source-mute",source,"1" if muted else "0")
            except Exception: remaining[source]=muted
        atomic_write(path,remaining)
        if remaining:
            self.holds={s:{"muted":v,"owners":set()} for s,v in remaining.items()}
            self.errors[1]="Microphone restoration pending; reconnect the microphone."
