                    self.send(writer,{"type":"result","id":msg.get("id"),"ok":True,"op":msg.get("op"),"state":result})
                except Exception as e: self.send(writer,{"type":"result","id":msg.get("id") if isinstance(msg,dict) else None,"ok":False,"error":str(e) or type(e).__name__})
