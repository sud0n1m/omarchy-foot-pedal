            self.sources=[{"value":s["name"],"label":s.get("description",s["name"])} for s in rows if not s["name"].endswith(".monitor")]
        except Exception: self.sources=[]
    def allowed(self): return self.config["enabled"] and self.test_owner is None and self.connected and not self.closing
    def input(self, current):
        if not any(current): self.baseline=True
        for i, down in enumerate(current):
            was=self.pressed[i]; self.pressed[i]=down
            if not down: self.armed[i]=True
            if down!=was:
                self.last_input={"pedal":i,"pressed":down,"time":time.time()}
                if not down: self.spawn(self.release(i))
                elif self.armed[i] and self.allowed():
                    self.armed[i]=False
