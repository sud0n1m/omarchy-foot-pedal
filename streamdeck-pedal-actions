                else:self.device_error="Pedal disconnected — reconnect USB"
                self.publish()
            if self.test_owner is not None and time.monotonic()>self.test_until: await self.end_test()
            if any(not h["owners"] for h in self.holds.values()) and time.monotonic()>=next_restore:
                await self.release(-1)
                next_restore=time.monotonic()+2
            # HID, filtered udev and socket readers wake the loop directly.
            # Poll only if notifications are unavailable or device access failed.
            deadlines=[]
            if self.fd is None and (not self.monitor or access_retry): deadlines.append(next_discovery)
            if self.test_owner is not None: deadlines.append(self.test_until)
            if any(not h["owners"] for h in self.holds.values()): deadlines.append(next_restore)
            self.wake.clear()
            if self.fd is None and self.rescan:continue
            if deadlines:
                try: await asyncio.wait_for(self.wake.wait(),max(0,min(deadlines)-time.monotonic()))
                except asyncio.TimeoutError: pass
            else: await self.wake.wait()
    async def serve(self):
        self.runtime.mkdir(mode=0o700,parents=True,exist_ok=True)
        self.lock=open(self.runtime/"daemon.lock","w")
        try:fcntl.flock(self.lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:raise SystemExit("The pedal service is already running")
        await self.recover();await self.discover_sources()
        try:self.startup=(await run("systemctl","--user","is-enabled",UNIT))=="enabled"
        except Exception:pass
        sock=self.runtime/"control.sock";sock.unlink(missing_ok=True)
        server=await asyncio.start_unix_server(self.client,path=sock,limit=65536);os.chmod(sock,0o600)
        stop=asyncio.Event()
        loop=asyncio.get_running_loop()
        for sig in [signal.SIGINT,signal.SIGTERM]:loop.add_signal_handler(sig,stop.set)
        self.start_monitor()
        watcher=asyncio.create_task(self.watch())
        await stop.wait()
        self.closing=True;self.epoch+=1;watcher.cancel()
        if self.monitor:loop.remove_reader(self.monitor.fd);self.monitor.close()
        # Python 3.14 Server.wait_closed waits for clients too. Close them before
        # waiting, otherwise a persistent panel connection deadlocks service stop.
        server.close()
        for w in tuple(self.clients): w.close()
        if self.fd is not None:loop.remove_reader(self.fd);os.close(self.fd)
        for t in tuple(self.tasks):t.cancel()
        await asyncio.gather(*self.tasks,return_exceptions=True)
        await self.release_all()
        await server.wait_closed()
        sock.unlink(missing_ok=True)

async def client_request(request):
    reader,writer=await asyncio.open_unix_connection(SOCKET,limit=1048576)
    writer.write((json.dumps(dict(request,id=1))+"\n").encode());await writer.drain()
    try:
        while line:=await reader.readline():
            msg=json.loads(line)
            if msg.get("type")=="result" and msg.get("id")==1:return msg
    finally:writer.close();await writer.wait_closed()
    raise RuntimeError("Service closed the connection")

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--request",help="Send a JSON control request");parser.add_argument("--status",action="store_true")
    args=parser.parse_args()
    try:
        if args.request or args.status:
            result=asyncio.run(client_request(json.loads(args.request) if args.request else {"op":"status"}));print(json.dumps(result));sys.exit(0 if result.get("ok") else 1)
        else:asyncio.run(Daemon().serve())
    except (OSError,ValueError,RuntimeError) as e:
        print(json.dumps({"type":"offline","error":str(e)}),flush=True);sys.exit(1)
if __name__=="__main__":main()
