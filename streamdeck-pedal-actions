            self.monitor.close();self.monitor=None;self.rescan=True;self.publish()
    def refresh_actions(self):
        available={dep:bool(shutil.which(dep)) for dep in {v[1] for v in ACTIONS.values() if v[1]}}
        self.actions=[{"value":k,"label":v[0],"available":not v[1] or available[v[1]],"dependency":v[1]} for k,v in ACTIONS.items()]
    def presets(self): return copy.deepcopy(BUILTINS) + copy.deepcopy(self.config["presets"])
    def active(self): return next(p for p in self.presets() if p["id"]==self.config["active"])
    def status(self):
        return {"version":VERSION,"discovery":"udev" if self.monitor else "poll","connected":self.connected,"device_error":self.device_error,"config_error":self.config_error,
                "input_ready":self.baseline,"enabled":self.config["enabled"],"startup":self.startup,"active":self.config["active"],"presets":self.presets(),
                "pressed":self.pressed,"last_input":self.last_input,"errors":self.errors,"busy":sorted(self.busy),
                "testing":self.test_owner is not None,"sources":self.sources,
                "actions":self.actions}
    def send(self, writer, obj):
        self.send_packet(writer,(json.dumps(obj)+"\n").encode())
    def send_packet(self, writer, packet):
        if writer.is_closing(): return
        if writer.transport.get_write_buffer_size()>262144: writer.close(); return
        writer.write(packet)
    def publish(self):
        self.wake.set()
        packet=(json.dumps({"type":"state","state":self.status()})+"\n").encode()
        if packet==self.last_state: return
        self.last_state=packet
